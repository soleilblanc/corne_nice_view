// urob Settings tuned for 3840 x 2160 display resolution
#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // default 600, eyelash 1200, urob 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default 10, eyelash 25, urob 20

#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/num_word.dtsi>  // Requires auto-layer module.
#include <dt-bindings/zmk/mouse.h>
// #include <eyelash_42.dtsi>       // layout helper

// ───────────────────────────────────────────────── Define key positon ─────────────────────────────────────────────────
    #define LT0  5  // left-top row
    #define LT1  4
    #define LT2  3
    #define LT3  2
    #define LT4  1
    #define LT5  0

    #define RT0  7  // right-top row
    #define RT1  8
    #define RT2  9
    #define RT3 10
    #define RT4 11
    #define RT5 12

    #define LM0 18  // left-middle row
    #define LM1 17
    #define LM2 16
    #define LM3 15
    #define LM4 14
    #define LM5 13

    #define RM0 22  // right-middle row
    #define RM1 23
    #define RM2 24
    #define RM3 25
    #define RM4 26
    #define RM5 27

    #define LB0 33  // left-bottom row
    #define LB1 32
    #define LB2 31
    #define LB3 30
    #define LB4 29
    #define LB5 28

    #define RB0 36  // right-bottom row
    #define RB1 37
    #define RB2 38
    #define RB3 39
    #define RB4 40
    #define RB5 41

    #define LH0 44  // left thumb keys
    #define LH1 43
    #define LH2 42

    #define RH0 45  // right thumb keys
    #define RH1 46
    #define RH2 47

    #define LEC 34  // left encoder press

    #define RJU  6  // right joystick
    #define RJL 19
    #define RJC 20
    #define RJR 21
    #define RJD 35

    #define KEYS_L 1 2 3 4 5 14 15 16 17 18 29 30 31 32 33      // left hand
    #define KEYS_R 7 8 9 10 11 22 23 24 25 26 36 37 38 39 40    // right hand
    #define SIDE_L LT5 LM5 LB5                                  // left side
    #define SIDE_R RT5 RM5 RB5                                  // right side
    #define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                      // thumbs
    #define STICK_R RJU RJL RJC RJR RJD                         // right joystick

// ───────────────────────────────────────────────── Global settings ─────────────────────────────────────────────────
    // Define layer numbers
    #define DEF 0
    #define COL 1
    #define GAM 2
    #define EXC 3
    #define NAV 4
    #define NUM 5
    #define HOT 6
    #define MED 7
    #define ADJ 8
    #define CLE 9

    // Define timing
    #define QUICK_TAP_MS 175

    #define COMBO_TERM_FAST 18
    #define COMBO_TERM_SLOW 30

    #define COMBO_IDLE_FAST 150
    #define COMBO_IDLE_SLOW 50

    // Mouse Tweaking
    &mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

    &msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

    &mmv {
        acceleration-exponent = <1>;    // default 1
        time-to-max-speed-ms = <500>;   // default 300
        trigger-period-ms = <16>;
    };

    &msc {
        acceleration-exponent = <1>;    // default 0, eyelash 1
        time-to-max-speed-ms = <100>;   // default 300, eyelash 100
        delay-ms = <0>;                 // default 0
    };

    &sl {  // sticky-layer config
        ignore-modifiers;                   // allow chording sticky mods & layers
    };

// ───────────────────────────────────────────────── END Global settings ─────────────────────────────────────────────────

/ {
    behaviors {
// ───────────────────────────────────────────────── Smart, Auto-Layer; Tri-State ─────────────────────────────────────────────────
        smart_shft: smart_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk LSHFT>, <&caps_word>;
            mods = <(MOD_LSFT)>;
        };

        math_word: auto_layer_math {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <UP DOWN LEFT RIGHT PLUS MINUS STAR FSLH SPACE BSPC DEL DOT KP_DOT COMMA EQUAL CARET PRCNT TAB>;
            // ignore-alphas;
            ignore-numbers;
            ignore-modifiers;
        };

        // auto exchange_layer
        alEXC: auto_layer_EXCHANGE {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <INS TAB SPACE BSPC DEL DOT COMMA FSLH SEMI>;
            ignore-alphas;
            // ignore-numbers;
            ignore-modifiers;
        };

        //  hold to momentary layer, tap to auto_EXCHANGE
        mo_alEXC: mo_auto_EXCHANGE {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&alEXC EXC>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            // quick-tap-ms = <200>;
        };

        //  hold to key press, tap to auto_EXCHANGE
        kp_alEXC: kp_auto_EXCHANGE {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&alEXC EXC>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            // quick-tap-ms = <200>;
        };

        // tri EXCHANGE_layer
        tEXC: tri_EXCHANGE {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&mo EXC>, <&none>, <&mo EXC>;
            ignored-key-positions = <SIDE_L KEYS_L KEYS_R THUMBS>;
            ignored-layers = <EXC>;
        };

        //  hold to momentary layer, tap to tri_EXCHANGE
        mo_tEXC: mo_tri_EXCHANGE {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&tEXC>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            // quick-tap-ms = <200>;
        };

        // tri MEDIA_layer
        tMED: tri_MEDIA {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&tog MED>, <&none>, <&tog MED>;
            ignored-key-positions = <SIDE_L KEYS_L KEYS_R LH0 LH1>;
            ignored-layers = <MED>;
        };

        //  hold to momentary layer, tap to tri_MEDIA
        mo_tMED: mo_tri_MEDIA {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&tMED>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            // quick-tap-ms = <200>;
        };

        // cmd_tab swapper
        swapper_tab: swapper_tab {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LGUI>, <&kp TAB>, <&kt LGUI>;
            ignored-key-positions = <LT5 LM5 LT2 LT3 LM2 LM3>;
        };

        // cmd_grave swapper
        swapper_grave: swapper_grave {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LGUI>, <&kp GRAVE>, <&kt LGUI>;
            ignored-key-positions = <LT5 LM5 LT2 LT3 LM2 LM3>;
        };

        smart_gresc: smart_swapper {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mt LCTRL ESC>, <&swapper_grave>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        HOT_EXC_gr: HOT_slEXC_grave {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mosls HOT EXC>, <&kp GRAVE>;
            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
            keep-mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        hyper_EXC_gr: hyper_slEXC_grave {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kpsls LC(LA(LS(LGUI))) EXC>, <&kp GRAVE>;
            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
            keep-mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };
// ───────────────────────────────────────────────── Sticky ─────────────────────────────────────────────────
        // new sticky-key config, delay duration, quick-release, ignore-modifiers
        skq: sticky_key_quickrelease {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1500>;                  // default 1000
            quick-release;
            ignore-modifiers;                           // allow chording sticky mods & layers
        };

        //  hold to momentary layer, tap to sticky-key quickrelease
        kpskq: key_stickykey_quick {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&skq>;
            flavor = "balanced";
            tapping-term-ms = <220>;
        };

        //  hold to momentary layer, tap to sticky-key
        kpsk: key_stickykey {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&sk>;
            flavor = "balanced";
            tapping-term-ms = <220>;
        };

        // new sticky-layer config, delay duration, no quick-release, ignore-modifiers
        sls: stickylayer_slow {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <1500>;              // default 1000
            /delete-property/ quick-release;        //no quic-release
            ignore-modifiers;                       // allow chording sticky mods & layers
        };

        //  hold to key press, tap to sticky layer, no quick-release
        kpsls: keypress_stickylayer_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&sls>;
            flavor = "balanced";
            tapping-term-ms = <220>;
        };

        //  hold to key press, tap to sticky layer
        kpsl: keypress_stickylayer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&sl>;
            flavor = "balanced";
            tapping-term-ms = <220>;
        };

        //  hold to momentary layer, tap to sticky-layer slow
        mosls: layer_stickylayer_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&sls>;
            flavor = "balanced";
            tapping-term-ms = <220>;
        };
// ───────────────────────────────────────────────── Hold-tap ─────────────────────────────────────────────────
        //  layer-tap config, change flavor to balanced
        ltb: layertap_balance {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        //  layer-tap config, hold to layer, double tap and holding to repeat key
        ltq: layertap_quick {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <220>;
        };
// ───────────────────────────────────────────────── infused-kim's Homerow-Mods ─────────────────────────────────────────────────
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <QUICK_TAP_MS>;          // repeat on tap-into-hold
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <SIDE_R KEYS_R THUMBS>;
            hold-trigger-on-release;                // delay positional check until key-release
        };

        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <SIDE_L KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        hmlq: homerow_mode_left_quick {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <SIDE_R KEYS_R THUMBS>;
            // hold-trigger-on-release;
        };

        hmrq: homerow_mode_right_quick {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <SIDE_L KEYS_L THUMBS>;
            // hold-trigger-on-release;
        };

        // Homerow-Mods for Combos
        hml_tMED: hml_tri_MEDIA {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&tMED>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <SIDE_R KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
// ───────────────────────────────────────────────── Tap Dance ─────────────────────────────────────────────────;
    // arrows, arrows with modifier
        td_up: tapdance_up {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp UP>, <&mt LG(UP) LA(UP)>;
            tapping-term-ms = <250>;
        };

        td_lf: tapdance_left {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT>, <&mt LG(LEFT) LA(LEFT)>;
            tapping-term-ms = <250>;
        };

        td_dn: tapdance_down {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp DOWN>, <&mt LG(DOWN) LA(DOWN)>;
            tapping-term-ms = <250>;
        };

        td_rt: tapdance_right {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp RIGHT>, <&mt LG(RIGHT) LA(RIGHT)>;
            tapping-term-ms = <250>;
        };

    // symbols
        td_PAR: td_PAR {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&mt RPAR LPAR>, <&m_dPAR>;
        };

        td_BKT: td_BKT {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&mt RBKT LBKT>, <&m_dBKT>;
        };

        td_BRC: td_Double_BRC {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&mt RBRC LBRC>, <&m_dBRC>;
        };

        td_LTGT: td_LTGT {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&mt GT LT>, <&m_LTGT>;
        };


// ───────────────────────────────────────────────── END behaviors ─────────────────────────────────────────────────
    };

    combos {
        compatible = "zmk,combos";
// ───────────────────────────────────────────────── HRMs ─────────────────────────────────────────────────
        cb_hml_AS {
            bindings = <&hml LC(LALT) TILDE>;
            key-positions = <LM3 LM4>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_hml_SD {
            bindings = <&hml LA(LGUI) GRAVE>;
            key-positions = <LM2 LM3>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_hml_DF {
            bindings = <&hml LG(LSHFT) RET>;
            key-positions = <LM1 LM2>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_hml_SF {
            bindings = <&hml_tMED LA(LSHFT) 0>;
            key-positions = <LM1 LM3>;
        };

        cb_hml_JK {
            bindings = <&hmr RS(RGUI) LBKT>;
            key-positions = <RM1 RM2>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_hml_KL {
            bindings = <&hmr RA(RGUI) RBKT>;
            key-positions = <RM2 RM3>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_hml_LSemi {
            bindings = <&hmr RA(RCTRL) EQUAL>;
            key-positions = <RM3 RM4>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };
// ───────────────────────────────────────────────── left hand: vertical ─────────────────────────────────────────────────
        cb_QA {
            bindings = <&mt QMARK EXCL>;
            key-positions = <LT4 LM4>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_WS {
            bindings = <&mt AMPS AT>;
            key-positions = <LT3 LM3>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_ED {
            bindings = <&mt STAR HASH>;
            key-positions = <LT2 LM2>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_RF {
            bindings = <&mt LA(Y) DLLR>;
            key-positions = <LT1 LM1>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_TG {
            bindings = <&mt CARET PRCNT>;
            key-positions = <LT0 LM0>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_SX {
            bindings = <&mt SEMICOLON COMMA>;
            key-positions = <LM3 LB3>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_DC {
            bindings = <&mt COLON DOT>;
            key-positions = <LM2 LB2>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_FV {
            bindings = <&mt DQT SQT>;
            key-positions = <LM1 LB1>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        // cb_GB {
        //     bindings = <&kp PIPE>;
        //     key-positions = <LM0 LB0>;
        //     timeout-ms = <COMBO_TERM_SLOW>;
        //     require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        // };
// ───────────────────────────────────────────────── left hand: horizontal ─────────────────────────────────────────────────
        cb_WE {
            bindings = <&swapper_tab>;
            key-positions = <LT2 LT3>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_ER {
            bindings = <&kp ESC>;
            key-positions = <LT1 LT2>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_ZX {
            bindings = <&kp EQUAL>;
            key-positions = <LB3 LB4>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_XC {
            bindings = <&kp MINUS>;
            key-positions = <LB2 LB3>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_CV {
            bindings = <&kp UNDER>;
            key-positions = <LB1 LB2>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };
// ───────────────────────────────────────────────── left hand: diagonal ─────────────────────────────────────────────────
        // cb_ES {
        //     bindings = <&kp LC(LS(TAB))>;
        //     key-positions = <LT2 LM3>;
        //     timeout-ms = <COMBO_TERM_SLOW>;
        //     require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        // };

        // cb_EF {
        //     bindings = <&kp LC(TAB)>;
        //     key-positions = <LT2 LM1>;
        //     timeout-ms = <COMBO_TERM_SLOW>;
        //     require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        // };

        cb_DX {
            bindings = <&kp FSLH>;
            key-positions = <LM2 LB3>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_DV {
            bindings = <&mt PIPE BSLH>;
            key-positions = <LM2 LB1>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };
// ───────────────────────────────────────────────── right hand: horizontal ─────────────────────────────────────────────────
        // cb_NM {
        //     bindings = <&kp UNDER>;
        //     key-positions = <RB0 RB1>;
        //     timeout-ms = <COMBO_TERM_FAST>;
        //     require-prior-idle-ms = <COMBO_IDLE_FAST>;
        // };

        cb_MLt {
            bindings = <&kp UNDER>;
            key-positions = <RB1 RB2>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_LtGt {
            bindings = <&kp PIPE>;
            key-positions = <RB2 RB3>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };
// ───────────────────────────────────────────────── right hand: vertical ─────────────────────────────────────────────────
        cb_YH {
            bindings = <&kp CARET>;
            key-positions = <RT0 RM0>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_UJ {
            bindings = <&kp PLUS>;
            key-positions = <RT1 RM1>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_IK {
            bindings = <&kp STAR>;
            key-positions = <RT2 RM2>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_OL {
            bindings = <&kp AMPS>;
            key-positions = <RT3 RM3>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_JM {
            bindings = <&kp MINUS>;
            key-positions = <RM1 RB1>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_KLt {
            bindings = <&kp FSLH>;
            key-positions = <RM2 RB2>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };

        cb_LGt {
            bindings = <&kp BSLH>;
            key-positions = <RM3 RB3>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };
// ───────────────────────────────────────────────── functional ─────────────────────────────────────────────────
        cb_QW {
            bindings = <&mt LG(RBKT) LG(LBKT)>;
            key-positions = <LT3 LT4>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_RT {
            bindings = <&td_PAR>;
            key-positions = <LT0 LT1>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_FG {
            bindings = <&td_BKT>;
            key-positions = <LM0 LM1>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_VB {
            bindings = <&td_LTGT>;
            key-positions = <LB0 LB1>;
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
        };

        cb_FB {
            bindings = <&td_BRC>;
            key-positions = <LM1 LB0>;
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
        };
// ───────────────────────────────────────────────── Layer switch ─────────────────────────────────────────────────
        cb_WA {
            bindings = <&tog COL>;
            key-positions = <LT3 LM4>;
        };

        cb_RG {
            bindings = <&tog GAM>;
            key-positions = <LT1 LM0>;
        };

        cb_SZ {
            bindings = <&tog ADJ>;
            key-positions = <LM3 LB4>;
        };

        // cb_WR {
        //     bindings = <&tHOT>;
        //     key-positions = <LT1 LT3>;
        // };

        cb_XV {
            bindings = <&math_word NAV>;
            key-positions = <LB1 LB3>;
        };

        cb_LFslh {
            bindings = <&tog ADJ>;
            key-positions = <RM3 RB4>;
        };

        cb_UO {
            bindings = <&tog CLE>;
            key-positions = <RT1 RT3>;
        };

        cb_MGt {
            bindings = <&math_word NAV>;
            key-positions = <RB1 RB3>;
        };
// ───────────────────────────────────────────────── END Combos ─────────────────────────────────────────────────
    };

    macros {
// ───────────────────────────────────────────────── Macros ─────────────────────────────────────────────────
        m_dPAR: m_double_PAR {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };

        m_dBKT: m_doubel_BKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
        };

        m_dBRC: m_double_BRC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
        };

        m_LTGT: m_LT_GT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp GT &kp LEFT>;
        };

        // // holding FN key and tap
        // fk: fk {
        //     compatible = "zmk,behavior-macro-one-param";
        //     wait-ms = <0>;
        //     #binding-cells = <1>;
        //     bindings = <&macro_press &kp INS>
        //              , <&macro_wait_time 300>
        //              , <&macro_param_1to1>
        //              , <&kp MACRO_PLACEHOLDER>
        //              , <&macro_release &kp INS>;
        // };
// ───────────────────────────────────────────────── END Macros ─────────────────────────────────────────────────
    };

// ───────────────────────────────────────────────── Encoder ─────────────────────────────────────────────────
    rgb_enc: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    vol_enc: volume_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp LA(LS(C_VOL_UP))>, <&kp LA(LS(C_VOL_DN))>;
    };

    scrl_enc: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };
// ───────────────────────────────────────────────── END Encoder ─────────────────────────────────────────────────

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&mt INS TAB      &kp Q         &kp W        &hml LC(LA(LS(LGUI))) E  &kp R          &kp T                                   &kp UP               &kp Y           &kp U          &hmr RC(RA(RS(RGUI))) I   &kp O        &kp P            &mt INS MINUS
&hyper_EXC_gr    &hml LCTRL A  &hml LALT S  &hml LGUI D              &hmlq LSHFT F  &kp G                         &kp LEFT  &kp RET   &kp RIGHT  &kp H           &hmrq RSHFT J  &hmr RGUI K               &hmr RALT L  &hmr RCTRL SEMI  &kp SQT
&kpsl LSHFT HOT  &kp Z         &kp X        &hml LC(LA(LSHFT)) C     &kp V          &kp B           &kp C_MUTE              &kp DOWN             &kp N           &kp M          &hmr LC(LA(LSHFT)) COMMA  &kp DOT      &kp FSLH         &kp BSLH
                                            &mt LGUI ESC             &ltb NAV BSPC  &ltq NUM SPACE                                               &mosls NUM NUM  &ltb HOT RET   &smart_shft
            >;
            sensor-bindings = <&vol_enc>;
        };

        colemakDH_layer {
            display-name = "ARSTGM";
            bindings = <
&trans  &trans  &trans       &hml LC(LA(LS(LGUI))) F  &kp P          &kp B                   &trans          &kp J   &kp L          &hmr RC(RA(RS(RGUI))) U  &kp Y        &kp SEMI      &trans
&trans  &trans  &hml LALT R  &hml LGUI S              &hmlq LSHFT T  &trans          &trans  &trans  &trans  &kp M   &hmrq RSHFT N  &hmr RGUI E              &hmr RALT I  &hmr RCTRL O  &trans
&trans  &trans  &trans       &trans                   &kp D          &kp V   &trans          &trans          &kp K   &kp H          &trans                   &trans       &trans        &trans
                             &trans                   &trans         &trans                                  &trans  &trans         &trans
            >;
            sensor-bindings = <&vol_enc>;
        };

        gaming_layer {
            display-name = "GAME";
            bindings = <
&kp TAB           &kp T  &kp Q  &kp W          &kp E           &kp R                    &trans          &kp Y   &kp U   &kp I      &kp O    &kp P     &trans
&trans            &kp G  &kp A  &kp S          &kp D           &kp F            &trans  &trans  &trans  &kp H   &kp J   &kp K      &kp L    &kp SEMI  &trans
&kpsk LALT LSHFT  &kp B  &kp Z  &kp X          &kp C           &kp V  &trans            &trans          &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
                                &mt LCTRL ESC  &mosls NUM NUM  &kp SPACE                                &trans  &trans  &trans
            >;
            sensor-bindings = <&vol_enc>;
        };

        exchange_layer {
            display-name = "CHANGE";
            bindings = <
&trans             &kp Y         &kp U        &hml LC(LA(LS(LGUI))) I   &kp O          &kp P                        &trans          &kp Q   &kp W          &hmr RC(RA(RS(RGUI))) E  &kp R        &kp T         &trans
&kp_alEXC LCTRL 0  &hml LCTRL H  &hml LALT J  &hml LGUI K               &hmlq LSHFT L  &kp SEMI             &trans  &trans  &trans  &kp A   &hmrq RSHFT S  &hmr RGUI D              &hmr RALT F  &hmr RCTRL G  &trans
&kpsk LALT LSHFT   &kp N         &kp M        &hml LC(LA(LSHFT)) COMMA  &kp DOT        &kp FSLH   &trans            &trans          &kp Z   &kp X          &hmr LC(LA(LSHFT)) C     &kp V        &kp B         &trans
                                              &trans                    &trans         &trans                                       &trans  &trans         &trans
            >;
            sensor-bindings = <&vol_enc>;
        };

        navipad_layer {
            display-name = "NAVPAD";
            bindings = <
&trans  &kp PG_UP  &kp HOME  &td_up    &kp END    &kp PRCNT                            &mmv MOVE_UP                     &kp CARET  &kp KP_N7          &kp KP_N8        &kp KP_N9        &kp KP_N0        &mt INS MINUS
&trans  &kp PG_DN  &td_lf    &td_dn    &td_rt     &key_repeat          &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp PLUS   &hmrq RSHFT KP_N4  &hmr RGUI KP_N5  &hmr RALT KP_N6  &hmr RCTRL STAR  &kp EQUAL
&trans  &sk LCTRL  &sk LALT  &sk LGUI  &sk LSHFT  &kp DEL    &trans                    &mmv MOVE_DOWN                   &kp MINUS  &kp KP_N1          &kp KP_N2        &kp KP_N3        &kp FSLH         &m_dPAR
                             &trans     &trans      &trans                                                                &trans     &kp KP_DOT         &trans
            >;
            sensor-bindings = <&vol_enc>;
        };

        numfunc_layer {
            display-name = "NUMFN";
            bindings = <
&trans            &kp N1         &kp N2        &kp N3        &kp N4          &kp N5                                 &mmv MOVE_UP                     &none           &kp F7          &kp F8        &kp F9        &kp F12         &kpsk INS INS
&sk LGUI          &hml LCTRL N6  &hml LALT N7  &hml LGUI N8  &hmlq LSHFT N9  &kp N0                 &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none           &hmrq RSHFT F4  &hmr RGUI F5  &hmr RALT F6  &hmr RCTRL F11  &sk LCTRL
&kpsk LALT LSHFT  &mkp MB4       &mkp LCLK     &mkp MCLK     &mkp RCLK       &mkp MB5   &kp C_PP                    &mmv MOVE_DOWN                   &none           &kp F1          &kp F2        &kp F3        &kp F10         &trans
                                               &trans        &trans          &trans                                                                  &mo_tMED MED 0  &trans          &trans
            >;
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV>;
        };

        hotkeymouse_layer {
            display-name = "HOTMOU";
            bindings = <
&trans    &none      &kp LS(LG(N2))     &kp LS(LG(N3))  &kp LS(LG(N4))  &kp LS(LG(T))                                &mmv MOVE_UP                     &none     &msc SCRL_LEFT   &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP    &trans
&trans    &none      &none              &none           &none           &kp LG(H)                    &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &mkp MB4  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &trans
&kp CAPS  &kp LG(K)  &kp LA(LS(LG(V)))  &kp LA(LG(C))   &kp LA(LG(V))   &kp LA(LG(H))  &kp C_MUTE                    &mmv MOVE_DOWN                   &mkp MB5  &mkp LCLK        &mkp MCLK       &mkp RCLK        &none           &trans
                                        &trans          &mkp LCLK       &mkp RCLK                                                                     &trans    &trans           &trans
            >;
            sensor-bindings = <&scrl_enc>;
        };

        media_layer {
            display-name = "MEDIA";
            bindings = <
&kp LBKT   &kp RBKT  &kp LA(LEFT)  &kp UP    &kp LA(RIGHT)  &kp LG(T)                                &mmv MOVE_UP                     &none   &kp C_PREV     &kp C_PP      &kp C_NEXT  &kp C_VOL_UP  &none
&kp LT     &kp GT    &kp LEFT      &kp DOWN  &kp RIGHT      &kp F                    &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none   &none          &none         &none       &kp C_VOL_DN  &none
&kp COMMA  &kp DOT   &kp J         &kp C      &kp L         &kp Q      &kp C_MUTE                    &mmv MOVE_DOWN                   &none   &kp C_BRI_DN   &kp C_BRI_UP  &none       &kp C_MUTE    &none
                                   &trans     &trans        &kp SPACE                                                                 &trans  &trans         &trans
            >;

            sensor-bindings = <&vol_enc>;
        };

        adjust_layer {
            display-name = "ADJUST";
            bindings = <
&bt BT_CLR   &bt BT_SEL 0    &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_SEL 4                                         &rgb_ug RGB_SPI                   &out OUT_BLE     &out OUT_USB  &none            &ext_power EP_ON   &rgb_ug RGB_SPI  &none
&bootloader  &bt BT_CLR_ALL  &rgb_ug RGB_SAI  &none         &none            &rgb_ug RGB_BRI                      &rgb_ug RGB_EFR &mkp LCLK        &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &none         &none            &ext_power EP_OFF  &rgb_ug RGB_SPD  &bootloader
&sys_reset   &sys_reset      &rgb_ug RGB_SAD  &none         &none            &rgb_ug RGB_BRD  &rgb_ug RGB_TOG                     &rgb_ug RGB_SPD                   &rgb_ug RGB_HUD  &none         &rgb_ug RGB_EFR  &rgb_ug RGB_EFF    &none            &sys_reset
                                              &to DEF       &rgb_ug RGB_TOG  &studio_unlock                                                                         &none            &none         &to DEF
            >;
            sensor-bindings = <&rgb_enc>;
        };

        clean_layer {
            display-name = "CLEAN";
            bindings = <
&none  &none  &none  &none  &none  &none                  &none         &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none           &none         &none  &none  &none  &none  &none  &none
                     &none  &none  &none                                &none  &none  &none
            >;
            sensor-bindings = <&vol_enc>;
        };
    };
};
